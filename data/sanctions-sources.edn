   :statute/promulgated "2007-03-31"
   :source/url "https://laws.e-gov.go.jp/api/1/lawdata/419AC0000000022"
   :source/format :xml
   :source/http-status 200
   :source/retrieved-at "2026-08-21T02:34:46Z"
   :source/observed {:api "e-Gov 法令API v1" :result-code 0 :content-type "text/xml;charset=UTF-8"}
   :statute/note
